{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "resources",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "resourceUrl": {
      "type": "string"
    },
    "feature_image": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "featureImageFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "pluginOptions": {
        "upload": {
          "config": {
            "mimeTypes": [
              "image/*"
            ]
          }
        }
      }
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "template",
        "article",
        "video"
      ],
      "default": "template",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "videoFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "videos"
      ]
    }
  }
}
